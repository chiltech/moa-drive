<resources>
    <!-- The OS starting window precedes app preferences. Keep it quiet; the
         approved full-canvas artwork is rendered by MoaLaunchHost. -->
    <style name="Theme.MoaDrive" parent="Theme.MoaDrive.Base">
        <item name="android:windowSplashScreenBackground">@color/moa_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/moa_launch_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.MoaDrive.Light" parent="Theme.MoaDrive.LightBase">
        <item name="android:windowSplashScreenBackground">@color/moa_launch_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/moa_launch_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.MoaDrive.Dark" parent="Theme.MoaDrive.DarkBase">
        <item name="android:windowSplashScreenBackground">@color/moa_launch_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/moa_launch_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
